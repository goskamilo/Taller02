## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
out/

# Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons
.vs/
.vscode/
_ReSharper*/
*.DotSettings.user

# Rider
.idea/

# NuGet
*.nupkg
# NuGet Packages folder
packages/
# NuGet v3+
project.lock.json
project.fragment.lock.json

# dotnet publish
publish/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Entity Framework
*.dbmdl

# IIS Express
/.vs/**/applicationhost.config

# Rider and VS Code settings
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*~

# JetBrains Rider
.idea/

# Files created by Visual Studio
*.cache
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.ipch
*.iobj
*.ipdb

# Test result files
TestResults/

# Publish output
wwwroot/publish

# Azure Functions local settings
local.settings.json

# Secrets
secrets.json

# Coverage
coverage*/

# Dotnet tool restore
.dotnet/